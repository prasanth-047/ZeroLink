<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ ZeroLink"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ultra-Low-Power Android &amp; Windows Fabric"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_service_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Service Status: Checking..."
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_ble_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="BLE Radio: Standby (UUID 0xFE2C)"
                android:textColor="#E2E8F0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_connection_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Windows Client: Not Connected"
                android:textColor="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Windows Host Connection Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖥️ Windows PC Connection"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_host_ip"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="#0F172A"
                    android:hint="PC IP (127.0.0.1 or LAN IP)"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:text="127.0.0.1"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_connect_host"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#0EA5E9"
                    android:text="Connect"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Control Buttons -->
        <Button
            android:id="@+id/btn_toggle_service"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#2563EB"
            android:text="Start ZeroLink Service"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_grant_permissions"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#334155"
            android:text="🔑 Grant Bluetooth Permissions"
            android:textAllCaps="false"
            android:textColor="#F1F5F9"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_notification_access"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#334155"
            android:text="🔔 Enable Notification Access"
            android:textAllCaps="false"
            android:textColor="#F1F5F9"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_accessibility_service"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#334155"
            android:text="⚡ Background Clipboard Auto-Sync (No Root)"
            android:textAllCaps="false"
            android:textColor="#F1F5F9"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_battery_optimization"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#334155"
            android:text="🔋 Disable Battery Restrictions"
            android:textAllCaps="false"
            android:textColor="#F1F5F9"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_test_clipboard"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#334155"
            android:text="📋 Copy Test Text (Sync to PC)"
            android:textAllCaps="false"
            android:textColor="#F1F5F9"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_send_notif"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#334155"
            android:text="🔔 Send Test Notification to PC"
            android:textAllCaps="false"
            android:textColor="#F1F5F9"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_sync_photos"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#334155"
            android:text="📁 Sync Photos Catalog to PC"
            android:textAllCaps="false"
            android:textColor="#F1F5F9"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_screen_mirror"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#334155"
            android:text="📱 Start Screen Mirroring"
            android:textAllCaps="false"
            android:textColor="#F1F5F9"
            android:textSize="14sp" />

        <!-- Activity Log -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Activity &amp; Security Log:"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_logs"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:background="#020617"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:text="[Ready] Open ZeroLink to start sync.\n"
            android:textColor="#4ADE80"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>

